# sets: $DB, $REPLY
#select DB in mysql postgresql stop ; do
select DB in mariadb postgresql laravel stop ; do
	case $DB in
		"stop")
			sudo systemctl stop mariadb nginx valkey php-fpm
			sudo systemctl status mariadb nginx valkey | grep '.service -\|Active:'
			;;
		"laravel")
			sudo systemctl stop mariadb postgresql 
			sudo systemctl restart nginx valkey php-fpm
			sudo systemctl status nginx valkey php-fpm | grep '.service -\|Active:'
			;;
		*)
			sudo systemctl stop mariadb postgresql 
			sudo systemctl restart $DB nginx valkey php-fpm
			sudo systemctl status $DB nginx valkey php-fpm | grep '.service -\|Active:'

			# read -p "Elasticsearch [n]? " -n 1 -r
			echo		# (optional) move to a new line
			if [[ $REPLY =~ ^[Yy]$ ]]
			then
				sudo systemctl start elasticsearch
				sudo systemctl status elasticsearch | grep '.service -\|Active:'
			fi

			;;
	esac
	break	# or select will loop
done
